{
  "name": "agent-honeypot",
  "version": "1.0.0",
  "private": true,
  "description": "Logging-only endpoint for studying which AI agents discover newly listed MCP servers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "db:init:local": "wrangler d1 execute honeypot-logs --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute honeypot-logs --remote --file schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
